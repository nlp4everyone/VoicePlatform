# Model configuration
MODEL_NAME=openbmb/VoxCPM2
GPU_MEMORY_UTILIZATION=0.75
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=4
QUANTIZATION=fp8
# KV cache budget for stage 0 (bytes); 2 GiB by default
KV_CACHE_BYTES=2147483648

# Network configuration
VLLM_HOST=0.0.0.0
VLLM_PORT=8002  # host port; the container always listens on 8002

# Storage configuration
HF_CACHE_DIR=~/.cache/huggingface/hub   # host directory mounted as the model cache
