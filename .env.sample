# Model configuration
MODEL_NAME=kjanh/KhanhTTS-OmniVoice
GPU_MEMORY_UTILIZATION=0.5
# Optional: only needed if you hit Hugging Face download rate limits
HF_TOKEN=

# Network configuration
VLLM_HOST=0.0.0.0
VLLM_PORT=8002  # host port; the container always listens on 8002

# Storage configuration
HF_CACHE_DIR=~/.cache/huggingface/hub   # host directory mounted as the model cache
