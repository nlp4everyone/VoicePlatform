# Image configuration
# Upstream VieNeu-TTS commit baked into the image (its uv.lock pins the dependencies)
VIENEU_REF=85344322b7258b4e25479b692e8e3396baf9db34

# Serving configuration
# Concurrent streams batched on the GPU
VIENEU_MAX_STREAMS=16
# Extra requests allowed to wait for a free stream
VIENEU_QUEUE=16
# Seconds a queued request waits before getting HTTP 429
VIENEU_QUEUE_TIMEOUT=10
# Bearer key for the API (Authorization: Bearer <key>); leave empty for an open API
VIENEU_API_KEY=
VIENEU_WATERMARK=1

# Network configuration
# Host port; the container always listens on 8000
API_PORT=8000

# Storage configuration
# The model cache lives in the Docker volume `hf-cache`, no setting needed
# Only needed if the model download is rate limited
# HF_TOKEN=hf_...
